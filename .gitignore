.env
/vendor

# Archivos subidos por usuarios (comprobantes de pago, adjuntos de tickets)
/uploads/*
!/uploads/.htaccess

# Base de datos real: nunca se sube (tiene datos personales de clientes).
# La base de demostración, con datos ficticios, está en deploy/demo/datasense_demo.sql
/database/*.sql

# Configuración local de editores y del sistema
/.vs
/.vscode
*.log
Thumbs.db
.DS_Store

# Videos para redes sociales: se guardan aquí para tenerlos a mano, pero no se suben a GitHub ni al sitio (pesan mucho)
/videos/
