# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# local activa el simulador de pagos; en el hosting usa production
APP_ENV=local
# En producción, la dirección del sitio (enlaces de los correos y de las pasarelas de pago)
APP_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=datasense_analytics
DB_USER=root
DB_PASS=

# Correo saliente. MAIL_ENCRYPTION: tls (puerto 587), ssl (465) o none (solo pruebas)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=

# Pagos. PAGOS_ENTORNO=LOCAL usa el simulador; en el hosting debe ser PRODUCCION
PAGOS_ENTORNO=
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENTORNO=sandbox
ZELLE_CORREO=
ZELLE_TITULAR=
WU_BENEFICIARIO=
WU_CIUDAD=
WU_DOCUMENTO=
USDT_BILLETERA_TRC20=
TRM_RESPALDO=

# Datos de la empresa en los documentos contables
EMPRESA_NOMBRE=
EMPRESA_NIT=
EMPRESA_CIUDAD=
EMPRESA_REPRESENTANTE=
EMPRESA_CONTADOR=
EMPRESA_CONTADOR_TP=

ENCUESTA_SOPORTE_TOKEN=CSAT-001

# Redes sociales: solo se muestran las que tengan valor
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_X=
SOCIAL_WHATSAPP=
# Dirección que se escribe en los textos de las publicaciones del módulo Redes Sociales (por defecto, la del sitio)
REDES_ENLACE=
