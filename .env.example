# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# local activa el simulador de pagos; en el hosting usa production
APP_ENV=local
# En producción, la dirección del sitio (enlaces de los correos y de las pasarelas de pago)
APP_URL=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=datasense_analytics
DB_USER=root
DB_PASS=
# Base permanente en otro servidor (por ejemplo TiDB Cloud): una sola línea que reemplaza a las cinco de arriba.
# Se conecta cifrada (TLS) y, si está vacía, carga los datos de demostración una vez (cron/preparar_base.php).
# DATABASE_URL=mysql://usuario:clave@servidor:4000/datasense
# DB_SSL=1            conexión cifrada (por defecto en bases externas; 0 la apaga)
# DB_SSL_CA=          archivo de certificados (por defecto el del sistema)
# DATOS_MUESTRA=0     no generar el año de datos de muestra (cron/datos_muestra.php)

# Correo saliente. MAIL_ENCRYPTION: tls (puerto 587), ssl (465) o none (solo pruebas)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=

# Pagos. PAGOS_ENTORNO=LOCAL usa el simulador; en el hosting debe ser PRODUCCION
PAGOS_ENTORNO=
MP_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENTORNO=sandbox
ZELLE_CORREO=
ZELLE_TITULAR=
WU_BENEFICIARIO=
WU_CIUDAD=
WU_DOCUMENTO=
USDT_BILLETERA_TRC20=
TRM_RESPALDO=

# Datos de la empresa en los documentos contables
EMPRESA_NOMBRE=
EMPRESA_NIT=
EMPRESA_CIUDAD=
EMPRESA_REPRESENTANTE=
EMPRESA_CONTADOR=
EMPRESA_CONTADOR_TP=

ENCUESTA_SOPORTE_TOKEN=CSAT-001

# Redes sociales: solo se muestran las que tengan valor
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_X=
SOCIAL_WHATSAPP=
# Dirección que se escribe en los textos de las publicaciones del módulo Redes Sociales (por defecto, la del sitio)
REDES_ENLACE=

# Verificación en dos pasos: opcional (al registrarse se ofrece y se puede hacer después desde Mi perfil),
# obligatorio (nadie la puede omitir) o desactivado. En modo opcional el equipo interno igual la debe tener,
# salvo MFA_EQUIPO_OBLIGATORIO=0.
MFA_MODO=opcional
# Clave para cifrar los secretos de la verificación y los tokens de las redes (32 bytes en base64).
# Genérala una vez con: php -r "echo base64_encode(random_bytes(32));"   Si cambia, hay que reconectar las redes
# y cada persona debe configurar de nuevo su verificación. Sin ella se deriva de la clave de la base.
APP_KEY=

# Publicación automática en redes: con estos tokens la plataforma se conecta sola y el panel no los pide.
# Cómo obtenerlos: Redes Sociales › Publicación automática › "¿De dónde saco los tokens…?". Nunca los escribas en el código.
META_PAGE_TOKEN=
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=
# Opcionales: versión de las API y datos de la app de Meta para extender tokens cortos
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
LINKEDIN_VERSION=202608
